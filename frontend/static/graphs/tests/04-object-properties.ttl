@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix rxyz: <http://robsyc.xyz/> .

################################################################################
# TEST: OWL Object Properties
# 
# PURPOSE: Test owl:ObjectProperty detection and characteristics
#          - Simple domain/range
#          - Inverse properties (owl:inverseOf)
#          - Property characteristics (Functional, Symmetric, Transitive)
#          - Property hierarchy (rdfs:subPropertyOf)
#          - Property chains (owl:propertyChainAxiom)
#          - Flexible domain/range (schema:domainIncludes/rangeIncludes)
# 
# EXPECTED UI: ObjectProperty nodes with toggle for inverse view
#              Domain/range edges connecting to ObjectType nodes (toggle)
#              Characteristics badges
################################################################################

# -----------------------------------------------------------------------------
# 4.1 Simple ObjectProperty with domain/range
# -----------------------------------------------------------------------------

rxyz:creator a owl:ObjectProperty ;
    rdfs:label "creator" ;
    rdfs:comment "The agent who created this resource." ;
    rdfs:domain rxyz:CreativeWork ;
    rdfs:range rxyz:Agent ;
.
# NOTE: these domain/range objects are not defined here... 
# should we still visualize them as owl:Class ObjectType nodes since this is to be inferred?
# should we apply basic inference in the background or just hard code this into our app logic?
# perhaps dotted line for inferred nodes/edges, stored in a seperate graph/triple store

rxyz:about a owl:ObjectProperty ;
    rdfs:label "about" ;
    rdfs:comment "The subject matter of a creative work." ;
    rdfs:domain rxyz:CreativeWork ;
    rdfs:range rxyz:Topic ;
.

rxyz:writesAbout a owl:ObjectProperty ;
    rdfs:label "writes about" ;
    rdfs:comment "Topics an author writes about." ;
    rdfs:domain rxyz:Author ;
    rdfs:range rxyz:Topic ;
.

rxyz:status a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:comment "The publication status of a work." ;
    rdfs:domain rxyz:CreativeWork ;
.

# -----------------------------------------------------------------------------
# 4.2 Inverse Property Pairs
# UI: Show as single node with toggle between authorOf ↔ hasAuthor view
# -----------------------------------------------------------------------------

rxyz:authorOf a owl:ObjectProperty ;
    rdfs:label "author of" ;
    rdfs:comment "Relates an author to works they have written." ;
    rdfs:domain rxyz:Author ;
    rdfs:range rxyz:CreativeWork ;
    owl:inverseOf rxyz:hasAuthor ;
.

rxyz:hasAuthor a owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:comment "The author of a creative work." ;
    rdfs:domain rxyz:CreativeWork ;
    rdfs:range rxyz:Author ;
    owl:inverseOf rxyz:authorOf ;
.

rxyz:reviews a owl:ObjectProperty ;
    rdfs:label "reviews" ;
    rdfs:comment "A reviewer reviews content." ;
    rdfs:domain rxyz:Reviewer ;
    rdfs:range rxyz:CreativeWork ;
    owl:inverseOf rxyz:hasReviewer ;
.

rxyz:hasReviewer a owl:ObjectProperty ;
    rdfs:label "has reviewer" ;
    rdfs:comment "Content reviewed by this reviewer." ;
    rdfs:domain rxyz:CreativeWork ;
    rdfs:range rxyz:Reviewer ;
    owl:inverseOf rxyz:reviews ;
.

# -----------------------------------------------------------------------------
# 4.3 Flexible Domain/Range (schema.org style)
# -----------------------------------------------------------------------------

rxyz:hasBlogPost a owl:ObjectProperty ;
    rdfs:label "has blog post" ;
    rdfs:comment "A blog contains these posts." ;
    schema:domainIncludes rxyz:Blog ;
    rdfs:range rxyz:BlogPost ;
    owl:inverseOf rxyz:isPartOf ;
.

rxyz:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of" ;
    rdfs:comment "This resource is part of a larger resource." ;
    schema:domainIncludes rxyz:BlogPost, rxyz:Article ;
    schema:rangeIncludes rxyz:Blog, rxyz:CreativeWork ;
    owl:inverseOf rxyz:hasBlogPost ;
.

# -----------------------------------------------------------------------------
# 4.4 Property Characteristics
# -----------------------------------------------------------------------------

# FunctionalProperty: each subject has at most one value
rxyz:owner a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "owner" ;
    rdfs:comment "The single owner of a resource." ;
    rdfs:range rxyz:Agent ;
.

# SymmetricProperty: if A knows B, then B knows A
rxyz:knows a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "knows" ;
    rdfs:comment "Mutual acquaintance between persons." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Person ;
.

# NOTE: bit off to define our own broader/narrower transitive properties...
#   we should just stick to SKOS for this and rdfs:subClassOf for transitive hierarchy
# TransitiveProperty with inverse pair
rxyz:broader a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "broader" ;
    rdfs:comment "A broader (more general) topic." ;
    rdfs:domain rxyz:Topic ;
    rdfs:range rxyz:Topic ;
    owl:inverseOf rxyz:narrower ;
    rdfs:subPropertyOf skos:broader ;
.

rxyz:narrower a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "narrower" ;
    rdfs:comment "A narrower (more specific) topic." ;
    rdfs:domain rxyz:Topic ;
    rdfs:range rxyz:Topic ;
    owl:inverseOf rxyz:broader ;
    rdfs:subPropertyOf skos:narrower ;
.

# -----------------------------------------------------------------------------
# 4.5 Property Hierarchy (rdfs:subPropertyOf)
# -----------------------------------------------------------------------------

rxyz:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:comment "The person is a member of this organization." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Organization ;
    owl:inverseOf rxyz:hasMember ;
.

rxyz:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "The organization has this person as member." ;
    rdfs:domain rxyz:Organization ;
    rdfs:range rxyz:Person ;
    owl:inverseOf rxyz:memberOf ;
.

rxyz:worksFor a owl:ObjectProperty ;
    rdfs:label "works for" ;
    rdfs:comment "Employment relationship (subproperty of memberOf)." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Organization ;
    rdfs:subPropertyOf rxyz:memberOf ;
    owl:inverseOf rxyz:employs ;
.

rxyz:employs a owl:ObjectProperty ;
    rdfs:label "employs" ;
    rdfs:comment "The organization employs this person." ;
    rdfs:domain rxyz:Organization ;
    rdfs:range rxyz:Person ;
    rdfs:subPropertyOf rxyz:hasMember ;
    owl:inverseOf rxyz:worksFor ;
.

# -----------------------------------------------------------------------------
# 4.6 Property Chains (owl:propertyChainAxiom)
# -----------------------------------------------------------------------------

rxyz:colleagueOf a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "colleague of" ;
    rdfs:comment "Two people who work for the same organization." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Person ;
    owl:propertyChainAxiom ( rxyz:worksFor rxyz:employs ) ;
.

rxyz:parentOf a owl:ObjectProperty ;
    rdfs:label "parent of" ;
    rdfs:comment "Parent-child relationship." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Person ;
    owl:inverseOf rxyz:childOf ;
.

rxyz:childOf a owl:ObjectProperty ;
    rdfs:label "child of" ;
    rdfs:comment "Child-parent relationship." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Person ;
    owl:inverseOf rxyz:parentOf ;
.

rxyz:grandparentOf a owl:ObjectProperty ;
    rdfs:label "grandparent of" ;
    rdfs:comment "Grandparent relationship via property chain." ;
    rdfs:domain rxyz:Person ;
    rdfs:range rxyz:Person ;
    owl:propertyChainAxiom ( rxyz:parentOf rxyz:parentOf ) ;
.
