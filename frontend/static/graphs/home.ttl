@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rxyz: <http://rosyc.xyz#> .

# These are not used, but we should create an ontology to materialize all these equivalences
# @prefix schema: <https://schema.org/> .
# @prefix foaf: <http://xmlns.com/foaf/0.1/> .
# @prefix foaf: <http://xmlns.com/foaf/0.1/> .
# @prefix sioc: <http://rdfs.org/sioc/ns#> .
# @prefix cito: <http://purl.org/spar/cito/> .
# @prefix prov: <http://www.w3.org/ns/prov#> .


rxyz:Blog a rxyz:ObjectType ;
    rdfs:label "Blog" ;
    rdfs:comment "A blog is a collection of blog posts typically published by a single author." ;
.

rxyz:BlogPost a rxyz:ObjectType ;
    rdfs:label "Blog Post" ;
    rdfs:comment "A blog post is a piece of content that is published on a blog." ;
.

rxyz:hasBlogPost a rxyz:LinkType ;
    rdfs:label "Has Blog Post" ;
    rdfs:comment "A blog has a blog post." ;
    rxyz:source rxyz:Blog ;
    rxyz:sink rxyz:BlogPost ;
.