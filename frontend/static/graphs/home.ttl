@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rxyz: <http://rosyc.xyz#> .

# These are not used, but we should create an ontology to materialize all these equivalences
# @prefix foaf: <http://xmlns.com/foaf/0.1/> .
# @prefix sioc: <http://rdfs.org/sioc/ns#> .
# @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
# @prefix cito: <http://purl.org/spar/cito/> .
# @prefix prov: <http://www.w3.org/ns/prov#> .

<http://rosyc.xyz#> a schema:WebPage ;
    schema:name "robsyc.xyz" ;
    schema:creator rxyz:me ;
    schema:description "robsyc's personal knowledge graph" ;
    schema:hasPart rxyz:robsyc , rxyz:WelcomeNav ;
.

rxyz:WelcomeNav a schema:SiteNavigationElement ;
    rxyz:x 0 ;
    rxyz:y 0 ;
    schema:name "Welcome" ;
    schema:description "Your entry point to robsyc's knowledge graph. Load content to explore." ;
    schema:potentialAction rxyz:SearchBlogAction, rxyz:SearchAboutAction ;
.

rxyz:robsyc a foaf:Agent ;
    rxyz:x -90 ;
    rxyz:y 300 ;
    schema:name "robsyc" ;
    schema:image <https://avatars.githubusercontent.com/u/87700333> ;
    schema:description "Your guide through this knowledge graph." ;
.

##############################################################################################################################################
# Agent conversation and action elements
##############################################################################################################################################

rxyz:AgentConversation a schema:Conversation ;
    schema:hasPart rxyz:WelcomeMessage ;
.

rxyz:WelcomeMessage a schema:Message ;
    schema:sender rxyz:robsyc ;
    schema:text """Hey there! 👋

Welcome to my personal knowledge graph. This is an experimental space where semantic web meets modern UX.

What would you like to explore?""" ;
    # TODO: UI should visualize this underneath conversation with buttons for each action
    schema:potentialAction rxyz:SearchBlogAction, rxyz:SearchAboutAction, rxyz:AskAgentAction ;
.

rxyz:SearchBlogAction a schema:SearchAction , schema:Action ;
    schema:name "Blog" ; # TODO: UI should create button with this query
    schema:target rxyz:BlogShape ;
.

rxyz:SearchAboutAction a schema:SearchAction , schema:Action ;
    schema:name "About" ;
    schema:target rxyz:AboutShape ;
.

rxyz:AskAgentAction a schema:AskAction , schema:Action ;
    # schema:question ... # TODO: UI should create triple with user's question as object (schema:Question w/ schema:text)
    # Sending this to backend triggers ML workflow to generate response
    schema:name "Ask" ;
    schema:target rxyz:AgentConversation ; # TODO: how will we model the action of sending a message to the agent? backend ML task
.

##############################################################################################################################################
# Reusable Property Shapes
# These property shapes can be referenced by multiple node shapes to reduce redundancy.
##############################################################################################################################################

rxyz:NamePropertyShape a sh:PropertyShape ;
    rdfs:label "Name Property" ;
    rdfs:comment "Reusable property shape for schema:name - a required single string value." ;
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
.

rxyz:DescriptionPropertyShape a sh:PropertyShape ;
    rdfs:label "Description Property" ;
    rdfs:comment "Reusable property shape for schema:description - an optional single string value." ;
    sh:path schema:description ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
.

rxyz:ImagePropertyShape a sh:PropertyShape ;
    rdfs:label "Image Property" ;
    rdfs:comment "Reusable property shape for schema:image - an optional IRI." ;
    sh:path schema:image ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
.

rxyz:TextPropertyShape a sh:PropertyShape ;
    rdfs:label "Text Property" ;
    rdfs:comment "Reusable property shape for schema:text - a required single string value." ;
    sh:path schema:text ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
.

rxyz:XPropertyShape a sh:PropertyShape ;
    rdfs:label "X Coordinate Property" ;
    rdfs:comment "Reusable property shape for rxyz:x - horizontal position for visual layout." ;
    sh:path rxyz:x ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
.

rxyz:YPropertyShape a sh:PropertyShape ;
    rdfs:label "Y Coordinate Property" ;
    rdfs:comment "Reusable property shape for rxyz:y - vertical position for visual layout." ;
    sh:path rxyz:y ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
.

rxyz:PotentialActionPropertyShape a sh:PropertyShape ;
    rdfs:label "Potential Action Property" ;
    rdfs:comment "Reusable property shape for schema:potentialAction - a required list of actions." ;
    sh:path schema:potentialAction ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node rxyz:ActionShape ;
.

##############################################################################################################################################
# Home page navigation shape
##############################################################################################################################################

rxyz:WelcomeNavShape a sh:NodeShape ;
    rdfs:label "Welcome Navigation Shape" ;
    rdfs:comment "Validates the welcome navigation element displayed on the home page." ;
    sh:targetNode rxyz:WelcomeNav ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property 
        rxyz:NamePropertyShape ,
        rxyz:DescriptionPropertyShape ,
        rxyz:PotentialActionPropertyShape ,
        rxyz:XPropertyShape ,
        rxyz:YPropertyShape ;
.

##############################################################################################################################################
# Agent Shape
##############################################################################################################################################

rxyz:robsycAgentShape a sh:NodeShape ;
    rdfs:label "Robsyc Agent Shape" ;
    rdfs:comment "Validates the robsyc agent node that guides users through the knowledge graph." ;
    sh:targetNode rxyz:robsyc ;
    sh:property 
        rxyz:NamePropertyShape ,
        rxyz:DescriptionPropertyShape ,
        rxyz:ImagePropertyShape ,
        rxyz:XPropertyShape ,
        rxyz:YPropertyShape ,
        rxyz:robsycAgentShape_message ;
.

rxyz:robsycAgentShape_message a sh:PropertyShape ;
    rdfs:label "Sent Messages Property" ;
    rdfs:comment "Uses sh:inversePath to traverse from agent to messages where this agent is the sender." ;
    sh:path [ sh:inversePath schema:sender ] ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node rxyz:MessageShape ;
    sh:message "Agent must be referenced as sender of at least one message." ;
.

##############################################################################################################################################
# Message Shape (nested from agent via inverse path)
##############################################################################################################################################

rxyz:MessageShape a sh:NodeShape ;
    rdfs:label "Message Shape" ;
    rdfs:comment "Validates messages in agent conversations, reached via inverse path from agent." ;
    sh:targetClass schema:Message ;
    sh:property 
        rxyz:MessageShape_conversationPartOf ,
        rxyz:MessageShape_sender ,
        rxyz:TextPropertyShape ,
        rxyz:PotentialActionPropertyShape ;
.

rxyz:MessageShape_conversationPartOf a sh:PropertyShape ;
    rdfs:label "Part of Conversation Property" ;
    rdfs:comment "Uses sh:inversePath to ensure this message is part of exactly one conversation." ;
    sh:path [ sh:inversePath schema:hasPart ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:Conversation ;
    sh:message "Message must be part of exactly one schema:Conversation." ;
.

rxyz:MessageShape_sender a sh:PropertyShape ;
    rdfs:label "Sender Property" ;
    rdfs:comment "The agent who sent this message." ;
    sh:path schema:sender ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class foaf:Agent ;
.

##############################################################################################################################################
# Action Shapes
##############################################################################################################################################

rxyz:ActionShape a sh:NodeShape ;
    rdfs:label "Action Shape" ;
    rdfs:comment "Validates actions that can be taken by the agent." ;
    sh:targetClass schema:Action ;
    sh:property 
        rxyz:NamePropertyShape , 
        rxyz:ActionShape_target ,
        rxyz:ActionShape_question ;
.

rxyz:ActionShape_target a sh:PropertyShape ;
    rdfs:label "Target Shape Property" ;
    rdfs:comment "The SHACL shape IRI defining what content to retrieve." ;
    sh:path schema:target ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Action must target a URL." ;
.

rxyz:ActionShape_question a sh:PropertyShape ;
    rdfs:label "AskAction Question Property" ;
    rdfs:comment "User's question text (populated by UI when action is invoked)." ;
    sh:path schema:question ;
    sh:class schema:Question ;
    sh:maxCount 1 ;
.

##############################################################################################################################################
# Test Shape for ShapeNode component verification
##############################################################################################################################################

rxyz:TestThing a schema:Thing ;
    rxyz:x 400 ;
    rxyz:y -250 ;
    schema:name "Test Resource" ;
    schema:description "A simple test resource to verify the generic ShapeNode component works correctly." ;
    schema:url <https://example.org/test> ;
.

rxyz:TestThingShape a sh:NodeShape ;
    rdfs:label "Test Thing Shape" ;
    rdfs:comment "A simple shape for testing the generic ShapeNode visualization." ;
    sh:targetNode rxyz:TestThing ;
    sh:property 
        rxyz:NamePropertyShape ,
        rxyz:DescriptionPropertyShape ;
.

##################

rxyz:MyBlog a schema:Blog ;
    rxyz:x 400 ; 
    rxyz:y 300 ;
    schema:name "My Blog" ;
    schema:description "The robsyc.xyz blog! Where topics such as linked data, machine intelligence and anarchism are explored." ;
    schema:blogPost rxyz:firstBlogPost ;
.

rxyz:firstBlogPost a schema:BlogPosting ;
    schema:author rxyz:me ;
    schema:headline "What am I looking at?" ;
    schema:datePublished "2025-01-01T00:00:00"^^xsd:dateTime ;
    schema:dateModified "2025-01-01T00:00:00"^^xsd:dateTime ;
    schema:abstract "My very first blog post: a meta article about this website" ;
    schema:keywords "Semantic web", "Node-based UIs" ;
    schema:articleBody """Welcome to my revamped personal website and knowledge graph `robsyc.xyz` !

The goal of this web application is three fold:
1. To bridge traditional semantic web technologies with contemporary web development and machine learning. 
2. To express thoughts and beliefs and to share my work in a structured machine- and human-readable way.
3. To fuck around a bit; a playground for tinkering with shit that interests me.

Expect unconventional UX, radical takes, and my occasional stab at zoomer-humour. I sincerely hope you enjoy lurking through my knowledge graph!""" ; 
.

rxyz:BlogPostingShape a sh:NodeShape ;
    rdfs:label "BlogPosting" ;
    rdfs:comment "Node shape for schema:BlogPosting instances - child nodes of Blog containers." ;
    sh:targetClass schema:BlogPosting ;
    sh:closed false ;
    # This shape's instances are rendered inside a container, not as standalone nodes
    rxyz:isVisualized false ;
    rxyz:nodeType "blogPosting" ;
    sh:property [
        sh:path schema:headline ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Blog posts must have a single headline."
    ] , [
        sh:path schema:author ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class schema:Person ;
        sh:message "Author must reference a schema:Person."
    ] , [
        sh:path schema:datePublished ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Each blog post needs datePublished (xsd:dateTime)."
    ] , [
        sh:path schema:abstract ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Blog posts require a single abstract/description."
    ] , [
        sh:path schema:keywords ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Provide at least one keyword string per blog post."
    ] , [
        sh:path schema:articleBody ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Each blog post must include its articleBody string."
    ] ;
.

rxyz:Blog a sh:NodeShape ;
    rdfs:label "Blog" ;
    rdfs:comment "Node shape for schema:Blog instances - a container for BlogPostings." ;
    sh:targetClass schema:Blog ;
    sh:closed false ;
    # Container visualization hints
    rxyz:nodeType "container" ;
    rxyz:containerProperty schema:blogPost ;  # Property path to find children
    rxyz:childShape rxyz:BlogPostingShape ;   # Shape of child nodes
    rxyz:childNodeType "blogPosting" ;        # SvelteFlow node type for children
    rxyz:containerLabel "Posts" ;             # UI label for the expand button
    sh:property [
        sh:path schema:blogPost ;
        sh:class schema:BlogPosting ;
        sh:minCount 1 ;
        sh:message "Blogs must reference at least one schema:BlogPosting." ;
        sh:node rxyz:BlogPostingShape ;
    ] , [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Blogs must have a name." ;
    ] , [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Blogs must have a description." ;
    ] , [
        sh:path rxyz:x ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Blog nodes must carry their x coordinate." ;
    ] , [
        sh:path rxyz:y ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Blog nodes must carry their y coordinate." ;
    ] ;
.