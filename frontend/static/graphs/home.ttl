@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix rxyz: <http://rosyc.xyz#> .

# These are not used, but we should create an ontology to materialize all these equivalences
# @prefix schema: <https://schema.org/> .
# @prefix foaf: <http://xmlns.com/foaf/0.1/> .
# @prefix foaf: <http://xmlns.com/foaf/0.1/> .
# @prefix sioc: <http://rdfs.org/sioc/ns#> .
# @prefix cito: <http://purl.org/spar/cito/> .
# @prefix prov: <http://www.w3.org/ns/prov#> .


rxyz:Blog a rdfs:Class, sh:NodeShape ; # equivalent to SHACL 1.2 sh:ShapeClass
    rdfs:label "Blog" ;
    rdfs:comment "A blog is a collection of blog posts typically published by a single author." ;
    sh:property xyz:hasBlogPost ;
.

rxyz:BlogPost a rdfs:Class, sh:NodeShape ;
    rdfs:label "Blog Post" ;
    rdfs:comment "A blog post is a piece of content that is published on a blog." ;
    sh:property [
        a owl:DatatypeProperty, sh:PropertyShape ;
        sh:path rxyz:headline ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Blog posts must have a single headline." ;
    ] , [
        a owl:DatatypeProperty, sh:PropertyShape ;
        sh:path rxyz:text ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Blog posts must have a single text." ;
    ] , [
        a owl:DatatypeProperty, sh:PropertyShape ;
        sh:path rxyz:datePublished ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Blog posts must have a single date published." ;
    ] ;
.

rxyz:Blog_hasBlogPost a owl:ObjectProperty, sh:PropertyShape ;
    rdfs:label "Has Blog Post" ;
    rdfs:comment "A blog has a blog post." ;
    sh:path rxyz:hasBlogPost ;
    sh:node rxyz:BlogPost ;
    sh:minCount 1 ;
.